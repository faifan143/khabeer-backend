generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       Int       @id @default(autoincrement())
  image    String
  titleAr  String
  titleEn  String
  state    String
  services Service[]
}

model Service {
  id               Int               @id @default(autoincrement())
  image            String
  title            String
  description      String
  commission       Float?
  whatsapp         String
  state            String?
  serviceType      String            @default("NORMAL")
  categoryId       Int?
  offers           Offer[]
  orders           Order[]
  providerServices ProviderService[]
  category         Category?         @relation(fields: [categoryId], references: [id])
}

model Provider {
  id                Int                   @id @default(autoincrement())
  name              String
  image             String
  description       String
  state             String
  phone             String                @unique
  isActive          Boolean               @default(false)
  onlineStatus      Boolean               @default(true)
  officialDocuments String?
  isVerified        Boolean               @default(false)
  location          Json?
  createdAt         DateTime              @default(now())
  email             String?               @unique
  updatedAt         DateTime              @updatedAt
  password          String?
  fcm               String?
  locationTracking  LocationTracking[]
  offers            Offer[]
  orders            Order[]
  joinRequests      ProviderJoinRequest[]
  ratings           ProviderRating[]
  providerServices  ProviderService[]
  verification      ProviderVerification?

  @@unique([email, phone])
}

model User {
  id                Int              @id @default(autoincrement())
  name              String
  image             String
  address           String
  phone             String           @unique
  state             String
  isActive          Boolean          @default(false)
  officialDocuments String?
  email             String?          @unique
  password          String
  role              String           @default("USER")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  fcm               String?
  latitude          Decimal?         @db.Decimal(10, 8)
  longitude         Decimal?         @db.Decimal(11, 8)
  orders            Order[]
  ratings           ProviderRating[]
  userLocations     UserLocation[]

  @@unique([email, phone])
}

model UserLocation {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  latitude    Decimal  @db.Decimal(10, 8)
  longitude   Decimal  @db.Decimal(11, 8)
  address     String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDefault])
}

model Order {
  id                 Int                @id @default(autoincrement())
  userId             Int
  providerId         Int
  serviceId          Int
  status             String             @default("pending")
  orderDate          DateTime           @default(now())
  bookingId          String             @unique @default(cuid())
  commissionAmount   Float
  location           String?
  locationDetails    String?
  providerAmount     Float
  providerNetAmount  Float              // What provider actually receives after commission deduction
  providerLocation   Json?
  quantity           Int                @default(1)
  scheduledDate      DateTime?
  totalAmount        Float
  isMultipleServices Boolean            @default(false)
  servicesBreakdown  Json?
  activeConnections  ActiveConnection[]
  invoice            Invoice?
  locationTracking   LocationTracking[]
  provider           Provider           @relation(fields: [providerId], references: [id])
  service            Service            @relation(fields: [serviceId], references: [id])
  user               User               @relation(fields: [userId], references: [id])
}

model Invoice {
  id            Int       @id @default(autoincrement())
  orderId       Int       @unique
  paymentDate   DateTime?
  totalAmount   Float
  discount      Float     @default(0)
  paymentMethod String?
  paymentStatus String    @default("pending")
  payoutDate    DateTime?
  payoutStatus  String    @default("pending")
  deletedAt     DateTime?
  deletedBy     Int?
  isDeleted     Boolean   @default(false)
  order         Order     @relation(fields: [orderId], references: [id])
}

model ProviderVerification {
  id         String   @id @default(cuid())
  providerId Int      @unique
  status     String   @default("pending")
  documents  String[]
  adminNotes String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  provider   Provider @relation(fields: [providerId], references: [id])
}

model ProviderJoinRequest {
  id          Int      @id @default(autoincrement())
  providerId  Int
  requestDate DateTime @default(now())
  status      String   @default("pending")
  adminNotes  String?
  provider    Provider @relation(fields: [providerId], references: [id])
}

model ProviderService {
  id         Int      @id @default(autoincrement())
  providerId Int
  serviceId  Int
  isActive   Boolean  @default(true)
  price      Float    @default(0)
  provider   Provider @relation(fields: [providerId], references: [id])
  service    Service  @relation(fields: [serviceId], references: [id])
}

model Offer {
  id            Int      @id @default(autoincrement())
  providerId    Int
  serviceId     Int
  startDate     DateTime
  endDate       DateTime
  description   String
  isActive      Boolean  @default(true)
  offerPrice    Float
  originalPrice Float
  provider      Provider @relation(fields: [providerId], references: [id])
  service       Service  @relation(fields: [serviceId], references: [id])
}

model ProviderRating {
  id         Int      @id @default(autoincrement())
  userId     Int
  providerId Int
  rating     Float
  comment    String?
  ratingDate DateTime @default(now())
  orderId    Int?
  provider   Provider @relation(fields: [providerId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model LocationTracking {
  id         Int      @id @default(autoincrement())
  orderId    Int
  providerId Int
  latitude   Decimal  @db.Decimal(10, 8)
  longitude  Decimal  @db.Decimal(11, 8)
  accuracy   Decimal? @db.Decimal(5, 2)
  timestamp  DateTime @default(now())
  isActive   Boolean  @default(true)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerId])
  @@index([timestamp])
  @@index([isActive])
}

model ActiveConnection {
  id           Int      @id @default(autoincrement())
  userId       Int
  userType     String
  socketId     String   @unique
  orderId      Int?
  connectedAt  DateTime @default(now())
  lastActivity DateTime @default(now())
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userType])
  @@index([orderId])
  @@index([socketId])
  @@index([lastActivity])
}

model Otp {
  id          Int       @id @default(autoincrement())
  phoneNumber String
  otp         String
  purpose     String
  expiresAt   DateTime
  attempts    Int       @default(0)
  isUsed      Boolean   @default(false)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([phoneNumber])
  @@index([purpose])
  @@index([expiresAt])
  @@index([isUsed])
}

model SmsLog {
  id          Int      @id @default(autoincrement())
  phoneNumber String
  message     String
  status      String
  response    String?
  sentAt      DateTime @default(now())

  @@index([phoneNumber])
  @@index([status])
  @@index([sentAt])
}

model SystemSettings {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  category    String   @default("general")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SubAdmin {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String
  permissions Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdBanner {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  imageUrl     String?
  linkType     String   @default("external")
  externalLink String?
  providerId   Int?
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notification {
  id               Int       @id @default(autoincrement())
  title            String
  message          String
  imageUrl         String?
  targetAudience   Json
  status           String    @default("draft")
  recipientsCount  Int       @default(0)
  sentAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  data             Json?
  failureCount     Int       @default(0)
  notificationType String    @default("general")
  successCount     Int       @default(0)
}
